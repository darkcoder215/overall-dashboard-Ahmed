# ── Unified build output (produced by build.sh at repo root) ──
_site/
_build-logs/

# ── Per-tool build artefacts (each tool still builds locally too) ──
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.turbo/
**/.vercel/

# ── Next.js auto-generated type file (created by `next build`) ──
**/next-env.d.ts

# ── Envs ──
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# ── Logs / OS cruft ──
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
